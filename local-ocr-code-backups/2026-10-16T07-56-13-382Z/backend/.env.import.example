# Copy only these IMPORT_ settings into backend/.env (do not overwrite existing settings).
# local: PDF text layer and DOCX text extraction stay on this computer. Scanned pages/images fail clearly without OCR.
IMPORT_OCR_MODE=local
IMPORT_OCR_ALLOW_EXTERNAL=false
IMPORT_OCR_MAX_PAGES=10
# Enable external OCR only after selecting your provider/account and checking data use and fees.
# IMPORT_OCR_MODE=openai-compatible
# IMPORT_OCR_ALLOW_EXTERNAL=true
# IMPORT_OCR_ENDPOINT=https://YOUR-PROVIDER-HOST/compatible-mode/v1/chat/completions
# IMPORT_OCR_MODEL=YOUR-VISION-MODEL
# IMPORT_OCR_API_KEY=YOUR-PRIVATE-KEY
# Optional private storage; default is import-files beside the active SQLite database.
# IMPORT_STORAGE_DIR=C:\private-data\jingzhi-import-files
